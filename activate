#!/usr/bin/env bash
# ============================================================================
# venv-style activation for the Scout dev environment (pm-managed tools).
#
#   source ./activate      (bash / zsh, repo root)
#   .\activate.ps1         (PowerShell)
#
# Emits the composed pm env (PATH + tool vars) into the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `scout` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `scout pm
# install` and `scout update` keep that check.
# ============================================================================
_SCOUT_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[ -n "${ZSH_VERSION:-}" ] && setopt localoptions nonomatch shwordsplit
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_scout_test_env="--test-environment"
_scout_expect_extras=""
for _scout_arg in "$@"; do
    if [ -n "$_scout_expect_extras" ]; then
        _scout_test_env="--test-environment=$_scout_arg"
        _scout_expect_extras=""
        continue
    fi
    case "$_scout_arg" in
        --) break ;;
        --test-extras) _scout_expect_extras=1 ;;
        --test-extras=*) _scout_test_env="--test-environment=${_scout_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_scout_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _scout_arg _scout_test_env _scout_expect_extras
    return 2 2>/dev/null || exit 2
fi
# Setup runs in a child: failures must not exit or partially activate the
# caller's shell, and activation must not republish launchers or shell config.
if ! (
    unset PYTHONHOME PYTHONPATH VIRTUAL_ENV
    bash "$_SCOUT_REPO/setup-scout.sh" --runtime-only "$_scout_test_env"
) >&2; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _scout_arg _scout_test_env _scout_expect_extras
    return 1 2>/dev/null || exit 1
fi
unset _scout_arg _scout_test_env _scout_expect_extras

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __SCOUT_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

# Bootstrap Python only emits the environment; it does not install anything.
_scout_repo="$_SCOUT_REPO"
_scout_py=""
for _scout_candidate in "$_scout_repo/.venv/bin/python" "$_scout_repo/.venv/Scripts/python.exe" \
                         "$_scout_repo/venv/bin/python" "$_scout_repo/venv/Scripts/python.exe"; do
    [ -x "$_scout_candidate" ] && { _scout_py="$_scout_candidate"; break; }
done
if [ -z "$_scout_py" ]; then
    for _scout_store in "${SCOUT_RUNTIME_DIR:-}" "$_scout_repo/../tools" "${SCOUT_HOME:-$HOME/.scout}/tools"; do
        [ -n "$_scout_store" ] || continue
        [ -d "$_scout_store" ] || continue
        for _scout_candidate in "$_scout_store"/python-*/bin/python3 "$_scout_store"/python-*/python.exe "$_scout_store"/python-*/bin/python "$_scout_store"/python-*/bin/python.exe; do
            [ -x "$_scout_candidate" ] && { _scout_py="$_scout_candidate"; break; }
        done
        [ -n "$_scout_py" ] && break
    done
fi
if [ -z "$_scout_py" ]; then
    echo "activate: no bootstrap Python found; run setup-scout.sh" >&2
    return 1 2>/dev/null || exit 1
fi

# --- emit export lines from `pm env` ---
_scout_json="$(PYTHONHOME= PYTHONPATH="$_scout_repo" "$_scout_py" -m pm.environments)"
if [ -z "$_scout_json" ] || [ "${_scout_json#*{}" = "$_scout_json" ]; then
    echo "activate: could not read pm env (run ./setup-scout.sh first)" >&2
    unset _scout_repo _scout_os _scout_arch _scout_target _scout_store _scout_py _scout_json
    return 1 2>/dev/null || exit 1
fi

_scout_keys="$(printf '%s' "$_scout_json" | "$_scout_py" -c 'import json,sys; print(" ".join(json.load(sys.stdin)))' \
    | tr ' ' '\n' | grep -E '^[A-Za-z_][A-Za-z0-9_]*$' | tr '\n' ' ')"
[ -n "$_scout_keys" ] || _scout_keys="PATH"

# --- snapshot what we are about to change (deactivate restores this) ---
# __SCOUT_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__SCOUT_SAVED_PATH="$PATH"
for _scout_k in $_scout_keys; do
    [ -n "$_scout_k" ] || continue
    eval "__SCOUT_SAVED_$_scout_k=\"\${$_scout_k+set}\""
    eval "__SCOUT_PRIOR_$_scout_k=\${$_scout_k-__SCOUT_UNSET__}"
done

# Resolved before the export below replaces PATH.
_scout_cygpath="$(command -v cygpath 2>/dev/null || :)"

eval "$(printf '%s' "$_scout_json" | "$_scout_py" -c '
import json, sys, shlex, re
for k, v in json.load(sys.stdin).items():
    # Windows carries names like ProgramFiles(ARM) that are not valid
    # bash identifiers — skip them (they pass through untouched).
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k):
        continue
    print("export %s=%s" % (k, shlex.quote(str(v))))')"

# The MSYS/Cygwin runtime hands a native Windows Python these variables in
# Windows form (`C:\a;C:\b`) and converts them back only for its own children.
# Exported verbatim, bash splits PATH on ':' and finds no commands.
if [ -n "$_scout_cygpath" ]; then
    PATH="$("$_scout_cygpath" -u -p "$PATH")"
    for _scout_k in HOME TMPDIR TMP TEMP; do
        if [ -n "${!_scout_k-}" ]; then
            printf -v "$_scout_k" '%s' "$("$_scout_cygpath" -u "${!_scout_k}")"
        fi
    done
fi

# This checkout, not whichever `scout` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__SCOUT_WORKTREE="$_scout_repo"
# The branch names the worktree. A checkout cannot share a branch with another.
__SCOUT_WORKTREE_NAME="$(git -C "$_scout_repo" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__SCOUT_WORKTREE_NAME" ] || [ "$__SCOUT_WORKTREE_NAME" = HEAD ]; then
    __SCOUT_WORKTREE_NAME="$(basename "$_scout_repo")"
fi
__SCOUT_SAVED_PS1="${PS1-__SCOUT_UNSET__}"
__SCOUT_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__SCOUT_UNSET__}"

_scout_worktree_here() {
    _scout_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_scout_top" && pwd -P)" = "$(cd "$__SCOUT_WORKTREE" && pwd -P)" ]
}

scout() {
    _scout_worktree_here || {
        printf '%s\n' "scout: $(pwd) is outside $__SCOUT_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__SCOUT_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" scout "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe scout "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python scout "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe scout "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python scout "$@"
        else
            exec python scout "$@"
        fi
    )
}

_scout_prompt() {
    if [ "$__SCOUT_SAVED_PS1" = "__SCOUT_UNSET__" ]; then
        _scout_base_ps1=""
    else
        _scout_base_ps1="$__SCOUT_SAVED_PS1"
    fi
    if _scout_worktree_here; then
        PS1="($__SCOUT_WORKTREE_NAME) $_scout_base_ps1"
    else
        PS1="$_scout_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_scout_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_scout_prompt
fi
_scout_prompt

deactivate() {
    export PATH="$__SCOUT_SAVED_PATH"
    for _scout_k in $__SCOUT_KEY_LIST; do
        eval "_scout_was=\"\$__SCOUT_SAVED_$_scout_k\""
        eval "_scout_old=\"\$__SCOUT_PRIOR_$_scout_k\""
        if [ "$_scout_was" != "set" ]; then
            unset "$_scout_k"
        else
            export "$_scout_k=$_scout_old"
        fi
        unset "__SCOUT_SAVED_$_scout_k" "__SCOUT_PRIOR_$_scout_k"
    done
    if [ "$__SCOUT_SAVED_PS1" = "__SCOUT_UNSET__" ]; then
        unset PS1
    else
        PS1="$__SCOUT_SAVED_PS1"
    fi
    if [ "$__SCOUT_SAVED_PROMPT_COMMAND" = "__SCOUT_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__SCOUT_SAVED_PROMPT_COMMAND"
    fi
    unset __SCOUT_SAVED_PATH __SCOUT_KEY_LIST __SCOUT_ACTIVATED \
          __SCOUT_WORKTREE __SCOUT_WORKTREE_NAME \
          __SCOUT_SAVED_PS1 __SCOUT_SAVED_PROMPT_COMMAND
    unset -f deactivate scout _scout_worktree_here _scout_prompt
    unset _scout_k _scout_was _scout_old _scout_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__SCOUT_KEY_LIST="$_scout_keys"

unset _scout_repo _scout_os _scout_arch _scout_target _scout_store \
      _scout_py _scout_json _scout_keys _scout_k _scout_entry _scout_venvpy \
      _scout_winarch _scout_top _scout_cygpath
